APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/studentos-dev.db
# Production example: postgresql+asyncpg://studentos:password@postgres:5432/studentos
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=ca-student-os
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=15728640
# Optional OpenAI-compatible AI provider. Leave blank to disable AI requests locally.
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
